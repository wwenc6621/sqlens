{
  "name": "sqlens-vscode",
  "displayName": "Sqlens - Database Client & MCP",
  "description": "A fast, feature-rich database client for VSCode with built-in MCP server. Connect to MySQL, PostgreSQL, SQLite and more. Search: database, db, client, sql, mcp.",
  "version": "0.1.3",
  "publisher": "wwenc6621",
  "author": {
    "name": "wwenc6621",
    "url": "https://marketplace.visualstudio.com/publishers/wwenc6621"
  },
  "icon": "media/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wwenc6621/sqlens.git"
  },
  "homepage": "https://github.com/wwenc6621/sqlens#readme",
  "bugs": {
    "url": "https://github.com/wwenc6621/sqlens/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Data Science",
    "Visualization"
  ],
  "keywords": [
    "database",
    "db",
    "client",
    "sql",
    "mcp",
    "mysql",
    "postgresql",
    "sqlite",
    "redis",
    "mongodb",
    "query",
    "data"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onCustomEditor:sqlens.sqliteViewer",
    "onStartupFinished",
    "onView:sqlens.connections",
    "onView:sqlens.savedQueries",
    "onView:sqlens.schema",
    "onCommand:sqlens.newSavedQuery",
    "onCommand:sqlens.renameSavedQuery",
    "onCommand:sqlens.deleteSavedQuery",
    "onCommand:sqlens.refreshSavedQueries",
    "onCommand:sqlens.refreshDatabases",
    "onView:sqlens.queryResultsView",
    "onCommand:sqlens.newConnection",
    "onCommand:sqlens.newConnectionGroup",
    "onCommand:sqlens.renameConnectionGroup",
    "onCommand:sqlens.deleteConnectionGroup",
    "onCommand:sqlens.moveConnectionToGroup",
    "onCommand:sqlens.editConnection",
    "onCommand:sqlens.deleteConnection",
    "onCommand:sqlens.connect",
    "onCommand:sqlens.selectConnection",
    "onCommand:sqlens.disconnect",
    "onCommand:sqlens.testConnection",
    "onCommand:sqlens.newQuery",
    "onCommand:sqlens.saveQuery",
    "onCommand:sqlens.toggleQueryAutoSave",
    "onCommand:sqlens.changeQueryContext",
    "onCommand:sqlens.runQuery",
    "onCommand:sqlens.runAllQueries",
    "onCommand:sqlens.cancelQuery",
    "onCommand:sqlens.formatSQL",
    "onCommand:sqlens.queryHistory",
    "onCommand:sqlens.openTable",
    "onCommand:sqlens.openStructure",
    "onCommand:sqlens.showDDL",
    "onCommand:sqlens.copyCreateTable",
    "onCommand:sqlens.renameTable",
    "onCommand:sqlens.switchDatabase",
    "onCommand:sqlens.refreshConnections",
    "onCommand:sqlens.refreshSchema",
    "onCommand:sqlens.runStatementAt",
    "onCommand:sqlens.truncateTable",
    "onCommand:sqlens.dropTable",
    "onCommand:sqlens.quickSwitcher",
    "onCommand:sqlens.erDiagram",
    "onCommand:sqlens.exportData",
    "onCommand:sqlens.importData",
    "onCommand:sqlens.explainPlan",
    "onCommand:sqlens.openTerminal",
    "onCommand:sqlens.clearLogs",
    "onCommand:sqlens.showLogsOutput",
    "onCommand:sqlens.saveConnectionToProject",
    "onCommand:sqlens.openProjectConfig",
    "onCommand:sqlens.searchConnections",
    "onCommand:sqlens.editDatabase",
    "onCommand:sqlens.createDatabase",
    "onCommand:sqlens.createTable",
    "onCommand:sqlens.dumpDatabase",
    "onCommand:sqlens.importDatabase",
    "onCommand:sqlens.mcp.register",
    "onCommand:sqlens.mcp.copyConfig",
    "onCommand:sqlens.mcp.showActivity",
    "onCommand:sqlens.mcp.clearActivity",
    "onCommand:sqlens.mcp.copyEndpoint"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": ".sqlens.json",
        "url": "./resources/connections-schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "sqlens.sqliteViewer",
        "displayName": "%Sqlens SQLite Viewer%",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlens",
          "title": "%Sqlens%",
          "icon": "media/database.svg"
        }
      ],
      "panel": [
        {
          "id": "sqlens-panel",
          "title": "%Sqlens%",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "sqlens": [
        {
          "id": "sqlens.connections",
          "name": "%Connections%"
        },
        {
          "id": "sqlens.savedQueries",
          "name": "%Saved SQL%"
        },
        {
          "id": "sqlens.schema",
          "name": "%Schema%"
        }
      ],
      "sqlens-panel": [
        {
          "type": "webview",
          "id": "sqlens.queryResultsView",
          "name": "%Query Results%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlens.connections",
        "contents": "%No connections yet.\n[Create Connection](command:sqlens.newConnection)%"
      },
      {
        "view": "sqlens.savedQueries",
        "contents": "%A saved query is stored with its connection, so it is already on disk — no Save As needed.\n[New Saved Query](command:sqlens.newSavedQuery)\n[Create Connection](command:sqlens.newConnection)%"
      }
    ],
    "commands": [
      {
        "command": "sqlens.newConnection",
        "title": "%New Connection%",
        "category": "%Sqlens%",
        "icon": "$(add)"
      },
      {
        "command": "sqlens.newConnectionGroup",
        "title": "%New Connection Folder%",
        "category": "%Sqlens%",
        "icon": "$(new-folder)"
