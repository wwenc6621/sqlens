    "menus": {
      "view/title": [
        {
          "command": "sqlens.newConnection",
          "when": "view == sqlens.connections",
          "group": "navigation"
        },
        {
          "command": "sqlens.newConnectionGroup",
          "when": "view == sqlens.connections",
          "group": "navigation"
        },
        {
          "command": "sqlens.refreshSavedQueries",
          "when": "view == sqlens.savedQueries",
          "group": "navigation"
        },
        {
          "command": "sqlens.refreshConnections",
          "when": "view == sqlens.connections",
          "group": "navigation"
        },
        {
          "command": "sqlens.exportConnections",
          "when": "view == sqlens.connections",
          "group": "navigation@8"
        },
        {
          "command": "sqlens.importConnections",
          "when": "view == sqlens.connections",
          "group": "navigation@8"
        },
        {
          "command": "sqlens.newQuery",
          "when": "view == sqlens.connections && sqlens.hasActiveConnection",
          "group": "navigation"
        },
        {
          "command": "sqlens.refreshSchema",
          "when": "view == sqlens.schema",
          "group": "navigation"
        },
        {
          "command": "sqlens.createTable",
          "when": "view == sqlens.schema && sqlens.hasActiveConnection && sqlens.activeDriverRelational",
          "group": "navigation"
        },
        {
          "command": "sqlens.mcp.openPanel.running",
          "when": "view == sqlens.connections && sqlens.mcpRunning",
          "group": "navigation@9"
        },
        {
          "command": "sqlens.mcp.openPanel",
          "when": "view == sqlens.connections && !sqlens.mcpRunning",
          "group": "navigation@9"
        },
        {
          "command": "sqlens.mcp.openPanel.running",
          "when": "view == sqlens.queryResultsView && sqlens.mcpRunning",
          "group": "navigation"
        },
        {
          "command": "sqlens.mcp.openPanel",
          "when": "view == sqlens.queryResultsView && !sqlens.mcpRunning",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sqlens.mcp.openPanel.running",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlens.connect",
          "when": "view == sqlens.connections && viewItem =~ /connection-disconnected/",
          "group": "inline"
        },
        {
          "command": "sqlens.disconnect",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/",
          "group": "inline"
        },
        {
          "command": "sqlens.selectConnection",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/",
          "group": "1_manage@0"
        },
        {
          "command": "sqlens.editConnection",
          "when": "view == sqlens.connections && viewItem =~ /^connection/",
          "group": "1_manage@1"
        },
        {
          "command": "sqlens.saveConnectionToProject",
          "when": "view == sqlens.connections && (viewItem == connection-connected || viewItem == connection-disconnected)",
          "group": "1_manage@2"
        },
        {
          "command": "sqlens.moveConnectionToGroup",
          "when": "view == sqlens.connections && viewItem =~ /^connection/",
          "group": "1_manage@3"
        },
        {
          "command": "sqlens.newSavedQuery",
          "when": "view == sqlens.connections && viewItem =~ /^connection/",
          "group": "2_query@0"
        },
        {
          "command": "sqlens.newSavedQuery",
          "when": "view == sqlens.savedQueries && viewItem == savedQueryConnection",
          "group": "inline"
        },
        {
          "command": "sqlens.renameSavedQuery",
          "when": "view == sqlens.savedQueries && viewItem == savedQuery",
          "group": "1_manage@1"
        },
        {
          "command": "sqlens.deleteSavedQuery",
          "when": "view == sqlens.savedQueries && viewItem == savedQuery",
          "group": "3_danger@1"
        },
        {
          "command": "sqlens.renameConnectionGroup",
          "when": "view == sqlens.connections && viewItem == group",
          "group": "1_manage@1"
        },
        {
          "command": "sqlens.deleteConnectionGroup",
          "when": "view == sqlens.connections && viewItem == group",
          "group": "3_danger@1"
        },
        {
          "command": "sqlens.newQuery",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/",
          "group": "2_query@1"
        },
        {
          "command": "sqlens.erDiagram",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem !~ /(redis|clickhouse|elasticsearch|mongodb)/",
          "group": "2_query@2"
        },
        {
          "command": "sqlens.openTerminal",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem !~ /(redis|clickhouse|elasticsearch|mongodb)/",
          "group": "2_query@3"
        },
        {
          "command": "sqlens.createDatabase",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem !~ /(redis|clickhouse|elasticsearch|mongodb)/",
          "group": "2_query@4"
        },
        {
          "command": "sqlens.deleteConnection",
          "when": "view == sqlens.connections && viewItem =~ /^connection/",
          "group": "3_danger@1"
        },
        {
          "command": "sqlens.esCreateIndex",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /elasticsearch/",
          "group": "1_manage@3"
        },
        {
          "command": "sqlens.esDeleteIndex",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /elasticsearch/",
          "group": "1_manage@4"
        },
        {
          "command": "sqlens.esExport",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /elasticsearch/",
          "group": "1_manage@5"
        },
        {
          "command": "sqlens.esImport",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /elasticsearch/",
          "group": "1_manage@6"
        },
        {
          "command": "sqlens.mongoCreateCollection",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /mongodb/",
          "group": "1_manage@3"
        },
        {
          "command": "sqlens.mongoCreateIndex",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /mongodb/",
          "group": "1_manage@4"
        },
        {
          "command": "sqlens.mongoExport",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /mongodb/",
          "group": "1_manage@5"
        },
        {
          "command": "sqlens.mongoImport",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /mongodb/",
          "group": "1_manage@6"
        },
        {
          "command": "sqlens.mongoShell",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /mongodb/",
          "group": "1_manage@7"
        },
        {
          "command": "sqlens.clickhouseExport",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /clickhouse/",
          "group": "1_manage@3"
        },
        {
          "command": "sqlens.mssqlBcpExport",
          "when": "view == sqlens.connections && viewItem =~ /connection-connected/ && viewItem =~ /mssql/",
          "group": "1_manage@3"
        },
        {
          "command": "sqlens.redisExport",
          "when": "view == sqlens.connections && viewItem =~ /redis/",
          "group": "1_manage@3"
        },
        {
          "command": "sqlens.redisImport",
          "when": "view == sqlens.connections && viewItem =~ /redis/",
          "group": "1_manage@4"
        },
        {
          "command": "sqlens.refreshDatabases",
          "when": "view == sqlens.connections && viewItem =~ /^database/",
          "group": "1_actions@0"
        },
        {
          "command": "sqlens.editDatabase",
          "when": "view == sqlens.connections && viewItem =~ /^database/",
          "group": "1_actions@1"
        },
        {
          "command": "sqlens.dumpDatabase",
          "when": "view == sqlens.connections && viewItem =~ /^database/ && viewItem !~ /(redis|clickhouse|elasticsearch|mongodb)/",
          "group": "1_actions@2"
        },
        {
          "command": "sqlens.importDatabase",
          "when": "view == sqlens.connections && viewItem =~ /^database/ && viewItem !~ /(redis|clickhouse|elasticsearch|mongodb)/",
          "group": "1_actions@3"
        },
        {
          "command": "sqlens.erDiagram",
          "when": "view == sqlens.connections && viewItem =~ /^database/ && viewItem !~ /(redis|clickhouse|elasticsearch|mongodb)/",
          "group": "2_query@1"
        },
        {
          "command": "sqlens.openTable",
          "when": "view == sqlens.schema && viewItem =~ /^(table|view)$/",
          "group": "inline"
        },
        {
          "command": "sqlens.openStructure",
          "when": "view == sqlens.schema && viewItem == table && sqlens.activeDriverRelational",
          "group": "1_view@1"
        },
        {
          "command": "sqlens.showDDL",
          "when": "view == sqlens.schema && viewItem == table && sqlens.activeDriverRelational",
          "group": "1_view@2"
        },
        {
          "command": "sqlens.copyCreateTable",
          "when": "view == sqlens.schema && viewItem == table",
          "group": "1_view@3"
        },
        {
          "command": "sqlens.generateTestData",
          "when": "view == sqlens.schema && viewItem == table && sqlens.activeDriverRelational",
          "group": "1_view@4"
        },
        {
          "command": "sqlens.renameTable",
          "when": "view == sqlens.schema && viewItem == table && sqlens.activeDriverRelational",
          "group": "2_actions@3"
        },
        {
          "command": "sqlens.exportData",
          "when": "view == sqlens.schema && viewItem == table",
          "group": "2_actions@1"
        },
        {
          "command": "sqlens.importData",
          "when": "view == sqlens.schema && viewItem == table",
          "group": "2_actions@2"
        },
        {
          "command": "sqlens.truncateTable",
          "when": "view == sqlens.schema && viewItem == table && sqlens.activeDriverRelational",
          "group": "3_danger@1"
        },
        {
          "command": "sqlens.dropTable",
          "when": "view == sqlens.schema && viewItem == table && sqlens.activeDriverRelational",
          "group": "3_danger@2"
        }
      ],
      "editor/title": [
        {
          "command": "sqlens.runQuery",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "sqlens.saveQuery",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "sqlens.explainPlan",
          "when": "resourceLangId == sql && sqlens.activeDriverExplains",
          "group": "sqlens@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sqlens.runQuery",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "resourceLangId == sql"
      },
      {
        "command": "sqlens.runAllQueries",
        "key": "cmd+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "resourceLangId == sql"
      },
      {
        "command": "sqlens.cancelQuery",
        "key": "cmd+.",
        "mac": "cmd+.",
        "when": "sqlens.queryRunning"
      },
      {
        "command": "sqlens.formatSQL",
        "key": "cmd+shift+l",
        "mac": "cmd+shift+l",
        "when": "resourceLangId == sql"
      },
      {
        "command": "sqlens.queryHistory",
        "key": "cmd+shift+h",
        "mac": "cmd+shift+h"
      },
      {
        "command": "sqlens.newQuery",
        "key": "ctrl+t",
        "mac": "ctrl+t",
        "when": "sqlens.hasActiveConnection"
      },
      {
        "command": "sqlens.newConnection",
        "key": "cmd+n",
        "mac": "cmd+n",
        "when": "focusedView == sqlens.connections"
      },
      {
        "command": "sqlens.quickSwitcher",
        "key": "cmd+option+t",
        "mac": "cmd+option+t",
        "when": "sqlens.hasActiveConnection"
      }
    ],
    "configuration": {
      "title": "%Sqlens%",
      "properties": {
        "sqlens.defaultRowsPerPage": {
          "type": "number",
          "default": 1000,
          "description": "%Default number of rows per page in the data grid%"
        },
        "sqlens.autoSaveQueries": {
          "type": "boolean",
          "default": false,
          "description": "%Auto-save SQL query documents before running them%"
        },
        "sqlens.queryTimeout": {
          "type": "number",
          "default": 30,
          "description": "%Query timeout in seconds (0 = no timeout)%"
        },
        "sqlens.autoUppercaseKeywords": {
          "type": "boolean",
          "default": false,
          "description": "%Auto-uppercase SQL keywords while typing%"
        },
        "sqlens.safeMode": {
          "type": "boolean",
          "default": true,
          "description": "%Require confirmation before executing write queries%"
        },
        "sqlens.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "%Maximum reconnect attempts on connection loss%"
        },
        "sqlens.idleTimeout": {
          "type": "number",
          "default": 300,
          "description": "%Idle connection timeout in seconds (0 = never)%"
        },
        "sqlens.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "%Show Run buttons above SQL statements%"
        },
        "sqlens.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%Start the local MCP server so AI assistants can use Sqlens connections%"
        },
        "sqlens.mcp.port": {
          "type": "number",
          "default": 37421,
          "description": "%MCP server port (0 = auto). Falls back to nearby ports if occupied.%"
        },
        "sqlens.mcp.readOnly": {
          "type": "boolean",
          "default": true,
          "description": "%Only allow read statements (SELECT/SHOW/DESCRIBE/EXPLAIN) from AI assistants%"
        },
        "sqlens.mcp.writeMode": {
          "type": "string",
          "enum": [
            "confirm",
            "allow",
            "deny"
          ],
          "default": "confirm",
          "description": "%How AI write statements are handled: ask for confirmation, allow directly, or deny%"
        },
        "sqlens.mcp.maxRows": {
          "type": "number",
          "default": 100,
          "description": "%Maximum rows returned to AI assistants per query%"
        },
        "sqlens.mcp.maskSensitiveColumns": {
          "type": "boolean",
          "default": true,
          "description": "%Mask values of password/token-like columns in AI query results%"
        },
        "sqlens.mcp.activityRetention": {
          "type": "number",
          "default": 200,
          "description": "%Number of AI activity entries to keep (0 = unlimited)%"
        },
        "sqlens.mcp.activityPersist": {
          "type": "boolean",
          "default": true,
          "description": "%Persist AI activity to disk; when off, activity is cleared when the window closes%"
        },
        "sqlens.sharedConnections": {
          "type": "boolean",
          "default": true,
          "description": "%Share connections across all VS Code forks on this machine via a single config file%"
        },
        "sqlens.sharedConnections.storePasswords": {
          "type": "boolean",
          "default": true,
          "description": "%Store connection passwords inside the shared config file (needed for passwords to sync across IDEs)%"
        },
        "sqlens.mcp.allowedConnections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%Connections the AI may use (ids or names). Empty allows every connection%"
        },
        "sqlens.mcp.blockedTables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%Tables/collections/indexes the AI may never touch, matched by name%"
        },
        "sqlens.mcp.autoOpenActivity": {
          "type": "boolean",
          "default": true,
          "description": "%Automatically open the AI Activity panel when an AI assistant makes its first call%"
        },
        "sqlens.redis.scanCount": {
          "type": "number",
          "default": 100,
          "description": "%Number of keys scanned per SCAN batch when browsing Redis%"
        },
        "sqlens.redis.maxValuePreview": {
          "type": "number",
          "default": 512,
          "description": "%Maximum number of bytes to preview for a Redis value in the grid%"
        },
        "sqlens.redis.blockedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "FLUSHALL",
            "FLUSHDB",
            "SHUTDOWN",
            "CONFIG",
            "DEBUG",
            "KEYS",
            "MIGRATE",
            "SLAVEOF",
            "REPLICAOF",
            "MONITOR"
          ],
          "description": "%Additional Redis commands to block from execution (danger commands are always blocked)%"
        },
        "sqlens.clickhouse.stringMaxBytes": {
          "type": "number",
          "default": 512,
          "description": "%Maximum number of bytes to preview for a ClickHouse String value in the grid%"
        },
        "sqlens.clickhouse.allowMutations": {
          "type": "boolean",
          "default": false,
          "description": "%Allow in-grid mutation edits (ALTER TABLE ... UPDATE/DELETE) for ClickHouse connections%"
        },
        "sqlens.clickhouse.showSystemDatabase": {
          "type": "boolean",
          "default": false,
          "description": "%Show ClickHouse system databases in the schema tree%"
        },
        "sqlens.clickhouse.requireOrderByPagination": {
          "type": "boolean",
          "default": true,
          "description": "%Add ORDER BY (sorting key) to ClickHouse pagination queries for stable pages%"
        },
        "sqlens.clickhouse.useBackticks": {
          "type": "boolean",
          "default": true,
          "description": "%Quote ClickHouse identifiers with backticks (disable to use ANSI double quotes)%"
        },
        "sqlens.es.showSystemIndices": {
          "type": "boolean",
          "default": false,
          "description": "%Show Elasticsearch system indices (names starting with a dot)%"
        },
        "sqlens.es.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "%Elasticsearch request timeout in milliseconds%"
        },
        "sqlens.es.maxResultWindow": {
          "type": "number",
          "default": 10000,
          "description": "%Elasticsearch from + size result window; larger requests must use search_after%"
        },
        "sqlens.mongo.sampleSize": {
          "type": "number",
          "default": 100,
          "description": "%Number of MongoDB documents sampled to infer collection fields%"
        },
        "sqlens.mongo.maxValuePreview": {
          "type": "number",
          "default": 512,
          "description": "%Maximum number of bytes to preview for a MongoDB value in the grid%"
        },
        "sqlens.mongo.allowShellEval": {
          "type": "boolean",
          "default": false,
          "description": "%Allow full mongosh passthrough for MongoDB (not recommended)%"
        },
        "sqlens.mssql.encrypt": {
          "type": "boolean",
          "default": true,
          "description": "%Encrypt SQL Server connections (required by Azure SQL)%"
        },
        "sqlens.mssql.trustServerCertificate": {
          "type": "boolean",
          "default": false,
          "description": "%Trust self-signed certificates for SQL Server connections%"
        },
        "sqlens.mssql.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "%SQL Server query timeout in milliseconds%"
        }
      }
    },
    "languages": [
      {
        "id": "redis",
        "aliases": [
          "Redis",
          "redis"
        ],
        "extensions": [
          ".redis"
        ]
      },
      {
        "id": "es",
        "aliases": [
          "Elasticsearch",
          "elasticsearch"
        ],
        "extensions": [
          ".es"
        ]
      },
      {
        "id": "mongo",
        "aliases": [
          "MongoDB",
          "mongodb"
        ],
        "extensions": [
          ".mongo"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:better-sqlite3 --external:sql.js --external:cpu-features --external:*.node --alias:apache-arrow/Arrow.node=./src/shims/apache-arrow.ts --format=cjs --platform=node --target=node20",
    "build:webview": "cd webview-ui && npm run build",
    "watch": "npm run build:ext -- --watch --sourcemap",
    "dev": "concurrently \"npm run watch\" \"cd webview-ui && npm run dev\"",
    "test:unit": "esbuild tests/unit.test.ts tests/mcp.test.ts --bundle --platform=node --format=cjs --outdir=dist-tests --out-extension:.js=.cjs --alias:vscode=./src/shims/vscode.ts --alias:apache-arrow/Arrow.node=./src/shims/apache-arrow.ts && node --test dist-tests/unit.test.cjs dist-tests/mcp.test.cjs",
    "lint": "eslint src/ --ext .ts",
    "compile:tests": "tsc -p tsconfig.json",
    "test": "npm run compile:tests && node ./dist/test/runTest.js",
    "package": "vsce package",
    "final": "vsce package -o sqlens-vscode.vsix",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@elastic/elasticsearch": "^8.19.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ioredis": "^5.11.1",
    "mongodb": "^7.6.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "sql-formatter": "^15.4.0",
    "sql.js": "^1.14.1",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ssh2": "^1.15.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "glob": "^10.3.12",
    "mocha": "^10.4.0",
    "typescript": "^5.6.0"
  }
}
